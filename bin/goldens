#!/usr/bin/env ruby
# frozen_string_literal: true

# Development and CI script (not packaged with the gem): regenerates the golden images in test/golden/
# plus a JSON file of structural facts beside each. Goldens must be generated on the pinned CI image
# (see .github/workflows/goldens.yml); output from any other machine is not byte-comparable, so outside
# CI (no CI variable) it refuses to write unless CSV_PREVIEW_GOLDENS_FORCE=1 is set.
#
#   bundle exec bin/goldens

if ENV["CI"].to_s.empty? && ENV["CSV_PREVIEW_GOLDENS_FORCE"] != "1"
  abort "bin/goldens writes test/golden/ only on the pinned CI image (gh workflow run goldens.yml). " \
        "Goldens made on this machine would not match there byte for byte. " \
        "Set CSV_PREVIEW_GOLDENS_FORCE=1 to write them anyway."
end

require "json"
require "fileutils"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift File.expand_path("../test", __dir__)
require "csv_preview"
require "support/golden"

fixtures = File.expand_path("../test/fixtures", __dir__)
out = File.expand_path("../test/golden", __dir__)
FileUtils.mkdir_p(out)

Golden::NAMES.each do |name|
  source = File.join(fixtures, "#{name}.csv")
  File.binwrite(File.join(out, "#{name}.png"), CsvPreview.render(source))
  facts = Golden.facts(CsvPreview.layout(source))
  File.write(File.join(out, "#{name}.json"), "#{JSON.pretty_generate(facts)}\n")
  puts "wrote #{name}.png"
end
